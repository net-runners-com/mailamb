{
  "manifest_version": 2,
  "name": "mailamb — 送信者",
  "version": "0.18.1",
  "description": "送信時の二重送信防止 + 送信済バナー表示。下書き生成は worker-watcher が担当する最小構成。",
  "author": "mailamb",
  "icons": {
    "32": "icons/32.png",
    "64": "icons/64.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "mailamb@mailamb.local",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "messagesRead",
    "compose",
    "accountsRead",
    "storage",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": false
  }
}
