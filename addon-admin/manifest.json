{
  "manifest_version": 2,
  "name": "mailamb — 管理者ダッシュボード",
  "version": "0.1.0",
  "description": "ナレッジ CRUD と送信履歴を TB 内のタブで閲覧・管理する管理者用拡張",
  "author": "mailamb",
  "icons": {
    "32": "icons/32.png",
    "64": "icons/64.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "mailamb-admin@mailamb.local",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "accountsRead",
    "storage",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_title": "mailamb 管理",
    "default_icon": {
      "32": "icons/32.png"
    }
  },
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": false
  }
}
