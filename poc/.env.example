CF_ACCOUNT_ID=your_cloudflare_account_id
CF_API_TOKEN=your_api_token_with_workers_ai_read

# IMAP (母艦スクリプト用)
# Xserver / さくら / 独自鯖など: 通常のメールパスワード
# Gmail/Workspace: アプリパスワード (16文字) https://myaccount.google.com/apppasswords
IMAP_HOST=mail.yourcompany.com        # 例: sv1234.xserver.jp
IMAP_PORT=993                          # 993=SSL / 143=STARTTLS
IMAP_USER=info@yourcompany.com         # 共有メールアドレス
IMAP_PASSWORD=change_me

# 問い合わせとして扱うTo宛先（カンマ区切り、小文字で記載）
INQUIRY_ADDRS=info@yourcompany.com,contact@yourcompany.com

# Worker（mother が TB側送信済 msgid を取得するために使う）
WORKER_URL=https://mailamb.<your-subdomain>.workers.dev
WORKER_API_KEY=
