# ============================================================
#  mailamb デプロイ用 環境変数テンプレート
# ============================================================
#  使い方:
#    cp .env.example .env
#    値を埋める (<FILL_HERE> 部分)
#    ./scripts/deploy.sh      # wrangler secret put に流し込む
#
#  .env は .gitignore 済み。コミットしないこと。
# ============================================================

# ------------------------------------------------------------
# [1] mailamb Worker (worker/) 用
# ------------------------------------------------------------

# API Key (sender/admin addon が Bearer 認証で使う)
# 生成: openssl rand -hex 32
MAILAMB_API_KEY=<FILL_HERE>

# ------------------------------------------------------------
# [2] worker-watcher (worker-watcher/) 用
# ------------------------------------------------------------

# IMAP接続情報 (監視対象メールアカウント)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=<FILL_HERE>                     # 例: netrunners.business@gmail.com
IMAP_PASSWORD=<FILL_HERE>                 # Gmail App Password (16桁) or 鯖パスワード

# 監視フォルダ (Gmail ラベルも IMAP フォルダ扱い)
# 本番: INBOX
# テスト: mailamb-test  (Gmail でこのラベル名のフィルタ作る)
IMAP_INBOX=mailamb-test

# 下書き保存先フォルダ
# Gmail: [Gmail]/Drafts または テスト用ラベル
# 他鯖: INBOX.Drafts が多い
IMAP_DRAFTS=[Gmail]/Drafts

# ------------------------------------------------------------
# [3] CF リソース ID (wrangler.toml に埋め込む値)
# ------------------------------------------------------------
# 新規デプロイ時は以下を手動実行して ID を控え、
# worker/wrangler.toml の対応行に貼る:
#
#   npx wrangler kv:namespace create "PROCESSED"
#   → KV_PROCESSED_ID=<出力の id>
#
#   npx wrangler d1 create mailamb
#   → D1_MAILAMB_ID=<出力の database_id>
#
#   npx wrangler r2 bucket create mailamb-docs
#   npx wrangler vectorize create mailamb-docs --dimensions=1024 --metric=cosine

KV_PROCESSED_ID=<FILL_HERE>
D1_MAILAMB_ID=<FILL_HERE>

# ------------------------------------------------------------
# [4] 配布される設定 (sender/admin 拡張の設定メモに記入)
# ------------------------------------------------------------
# これらは deploy 後に判明する値。手で設定メモ.txt に書き写す:
#
#   WORKER_URL=https://mailamb.<account>.workers.dev
#   MAILAMB_API_KEY=  (上の [1] と同じ値)
#   送信者ID=         (各送信者が任意で決める、重複不可)
